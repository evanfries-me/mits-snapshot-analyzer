# ── AWS (required) ────────────────────────────────────────────────────────────
# Region (us-west-2) and bucket (elise-snapshots) are hardcoded in app.py.
AWS_ACCESS_KEY_ID=ASIA...
AWS_SECRET_ACCESS_KEY=...
AWS_SESSION_TOKEN=IQoJb3...

# ── Snowflake (optional) ──────────────────────────────────────────────────────
# Without these the app still runs as a plain S3 browser; the database
# enrichment simply stays hidden.
#
# Account looks like  ab12345.us-east-1  or  myorg-myaccount
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=

# Pick ONE authentication method:
#
#  1. Programmatic Access Token (PAT) — what Snowsight issues under
#     Profile -> Settings -> Authentication -> Programmatic access tokens.
#     SNOWFLAKE_ACCESS_TOKEN is accepted as an alias. Requires SNOWFLAKE_USER.
# SNOWFLAKE_ACCESS_TOKEN=
#
#  2. Password
# SNOWFLAKE_PASSWORD=
#
#  3. SSO / browser-based (opens a browser window on the machine running the app)
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
#
#  4. Key-pair
# SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
#
#  5. True OAuth bearer token (not a PAT — must set the authenticator)
# SNOWFLAKE_TOKEN=
# SNOWFLAKE_AUTHENTICATOR=oauth

# Session context
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Seconds before a query is aborted (default 120)
# SNOWFLAKE_QUERY_TIMEOUT=120
