{
  "version": 1,
  "stage_labels": {
    "-1": "Not supported",
    "0": "Available for viewing",
    "1": "Renovating",
    "2": "Tenant occupied",
    "3": "Commit sent/application",
    "4": "Application submitted",
    "5": "Pending application and not showing",
    "6": "Application approved",
    "7": "Awaiting rent/security payment",
    "8": "Lease out for signature",
    "9": "Lease signed"
  },
  "integrations": {
    "RentCafe": {
      "primary": ["apartment_availability_all_units.json.gz", "apartment_availability.json.gz"],
      "actual": ["unit_details.json.gz", "unit-details.json.gz"],
      "unit_key": {"components": [["voyagerPropertyCode"], ["apartmentName"]]},
      "unit_name_fields": ["apartmentName"],
      "primary_key": ["voyagerPropertyCode", "apartmentName"],
      "required_key": ["voyagerPropertyCode", "apartmentName"],
      "actual_key": ["building_unique_id", "external_id"],
      "fields": ["voyagerPropertyCode", "apartmentName", "voyagerApartmentId", "unitStatus", "minimumRent", "availableDate", "sqft"],
      "predict_unit_details_only": true,
      "supplemental_units": {
        "integrations": ["YardiVoyager", "PricingAvailsSourceType.YardiVoyager"],
        "files": ["AllUnits_Login"],
        "fields": ["@IDType", "@IDValue"],
        "nearest_snapshot_minutes": 15,
        "use_latest_historical_snapshot": true,
        "primary_id_field": "voyagerApartmentId",
        "supplemental_id_field": "@IDType",
        "supplemental_name_field": "@IDValue",
        "output_name_field": "apartmentName",
        "output_property_field": "voyagerPropertyCode"
      },
      "sources": [{"file": "property_details.json.gz", "fields": ["monthsAvailabilityRestrictedTo"]}],
      "direct": {"field": "unitStatus", "map": {}},
      "direct_rules": [
        {"stage": 0, "reason": "Status: Vacant Unrented Ready", "when": [{"field": "unitStatus", "op": "equals", "value": "Vacant Unrented Ready"}]},
        {"stage": 1, "reason": "Status: Vacant Unrented Not Ready", "when": [{"field": "unitStatus", "op": "equals", "value": "Vacant Unrented Not Ready"}]},
        {"stage": 1, "reason": "Status: Notice Unrented", "when": [{"field": "unitStatus", "op": "equals", "value": "Notice Unrented"}]},
        {"stage": 9, "reason": "Status: Occupied No Notice", "when": [{"field": "unitStatus", "op": "equals", "value": "Occupied No Notice"}]},
        {"stage": 9, "reason": "Status: Notice Rented", "when": [{"field": "unitStatus", "op": "equals", "value": "Notice Rented"}]},
        {"stage": 9, "reason": "Status: Vacant Rented Ready", "when": [{"field": "unitStatus", "op": "equals", "value": "Vacant Rented Ready"}]},
        {"stage": 9, "reason": "Status: Waitlist", "when": [{"field": "unitStatus", "op": "equals", "value": "Waitlist"}]},
        {"stage": 9, "reason": "Status: Vacant Rented Not Ready", "when": [{"field": "unitStatus", "op": "equals", "value": "Vacant Rented Not Ready"}]},
        {"stage": 9, "reason": "Status: Vacant Rented", "when": [{"field": "unitStatus", "op": "equals", "value": "Vacant Rented"}]},
        {"stage": 9, "reason": "Status: Lease Signed", "when": [{"field": "unitStatus", "op": "equals", "value": "Lease Signed"}]},
        {"stage": 9, "reason": "Status: Blank", "when": [{"field": "unitStatus", "op": "equals", "value": ""}]}
      ],
      "overrides": [
        {"stage": 9, "reason": "Missing Available Date", "when": [{"field": "availableDate", "op": "missing"}]},
        {"stage": 9, "reason": "Outside Availability Restriction Window", "when": [{"field": "availableDate", "op": "future_by_field_days", "days_field": "monthsAvailabilityRestrictedTo", "multiplier": 30}]},
        {"stage": 9, "reason": "Future Availability Cutoff: 1 Year", "when": [{"field": "__direct_stage", "op": "stage_in", "value": [0, 1]}, {"field": "availableDate", "op": "future_days", "value": 365}]},
        {"stage": 9, "reason": "Invalid Rent", "when": [{"field": "minimumRent", "op": "invalid_rent"}]},
        {"stage": 9, "reason": "Invalid Square Footage", "when": [{"field": "sqft", "op": "invalid_sqft"}]},
        {"stage": 9, "reason": "Present in Voyager but absent from RentCafe", "replace_reason": true, "when": [{"field": "__supplemental_unit", "op": "truthy"}]},
        {"stage": 9, "reason": "Absent from RentCafe; no Voyager snapshot found", "replace_reason": true, "when": [{"field": "__supplemental_snapshot_missing", "op": "truthy"}]}
      ]
    },
    "Voyager": {
      "primary": ["AvailableUnits_Login", "AllUnits_Login"],
      "actual": ["unit_details.json.gz", "unit-details.json.gz"],
      "unit_key": {"components": [["__file_property_code"], ["@IDValue"]]},
      "unit_name_fields": ["@IDValue"],
      "primary_key": ["__file_property_code", "@IDValue"],
      "required_key": ["@IDValue"],
      "actual_key": ["building_unique_id", "external_id"],
      "fields": ["@IDValue", "UnitLeasedStatus", "UnitLeasedStatusDescription", "Comment", "EffectiveRent", "MadeReadyDate"],
      "sources": [{"file": "AllUnits_Login", "join_key": ["@IDValue"], "fields": ["@IDValue", "UnitLeasedStatus", "EffectiveRent", "MadeReadyDate"]}],
      "building_fields": ["EXCLUDE_NOT_RENT_READY_UNITS"],
      "direct": {"field": "UnitLeasedStatus", "casefold": true, "map": {}},
      "direct_rules": [
        {"stage": 1, "reason": "Status: Available, RentReady: False", "when": [{"field": "UnitLeasedStatus", "op": "equals", "value": "available"}, {"field": "Comment", "op": "contains", "value": "RentReady=false"}]},
        {"stage": 0, "reason": "Status: Available, RentReady: True", "when": [{"field": "UnitLeasedStatus", "op": "equals", "value": "available"}]},
        {"stage": 1, "reason": "Status: On Notice, RentReady: False", "when": [{"field": "UnitLeasedStatus", "op": "equals", "value": "on_notice"}, {"field": "Comment", "op": "contains", "value": "RentReady=false"}]},
        {"stage": 0, "reason": "Status: On Notice, RentReady: True", "when": [{"field": "UnitLeasedStatus", "op": "equals", "value": "on_notice"}]},
        {"stage": 1, "reason": "Status: Not Ready", "when": [{"field": "UnitLeasedStatus", "op": "equals", "value": "not_ready"}]},
        {"stage": 5, "reason": "Status: Reserved", "when": [{"field": "UnitLeasedStatus", "op": "equals", "value": "reserved"}]},
        {"stage": 6, "reason": "Status: Approved", "when": [{"field": "UnitLeasedStatus", "op": "equals", "value": "approved"}]},
        {"stage": 9, "reason": "Status: Leased", "when": [{"field": "UnitLeasedStatus", "op": "equals", "value": "leased"}]},
        {"stage": 9, "reason": "Status: Leased On Notice", "when": [{"field": "UnitLeasedStatus", "op": "equals", "value": "leased_on_notice"}]},
        {"stage": 9, "reason": "Status: Leased Reserved", "when": [{"field": "UnitLeasedStatus", "op": "equals", "value": "leased_reserved"}]}
      ],
      "fallback": {"stage": -1, "reason": "Status: unsupported or unknown"},
      "overrides": [
        {"stage": 9, "reason": "Non Revenue Generating Unit", "when": [{"field": "UnitLeasedStatusDescription", "op": "equals", "value": "Non Revenue Generating Unit"}]},
        {"stage": 9, "reason": "Made-Ready Date: 0/0/0", "when": [{"field": "__made_ready_date_all_zero", "op": "truthy"}]},
        {"stage": 9, "reason": "Future Availability Cutoff: 1 Year", "when": [{"field": "__direct_stage", "op": "stage_in", "value": [0, 1]}, {"field": "MadeReadyDate", "op": "future_days", "value": 365}]},
        {"stage": 9, "reason": "Invalid Rent", "when": [{"field": "EffectiveRent", "op": "invalid_rent"}]},
        {"stage": 9, "reason": "Exclude Not Rent Ready Units", "when": [{"field": "__direct_stage", "op": "stage_in", "value": [1]}, {"field": "__building__EXCLUDE_NOT_RENT_READY_UNITS", "op": "truthy"}]}
      ]
    },
    "RealPage": {
      "primary": ["getunitlist"],
      "actual": ["unit_details.json.gz", "unit-details.json.gz"],
      "unit_key": {"components": [["__file_property_code"], ["UnitID"]]},
      "unit_name_fields": ["UnitNumber"],
      "primary_key": ["PropertyNumberID", "UnitID"],
      "required_key": ["UnitID"],
      "actual_key": ["building_unique_id", "external_id"],
      "fields": ["PropertyNumberID", "SiteID", "PropertyID", "UnitID", "UnitNumber", "BuildingNumber", "VacantBit", "AvailableBit", "MadeReadyBit", "MadeReadyDate", "EffectiveRent", "UnitMarketRent", "RentSqFtCount", "FloorNumber", "availability_stage"],
      "sources": [{"file": "getallunits", "join_key": ["UnitNumber"], "primary_key": ["UnitNumber"], "fields": ["UnitNumber", "BuildingNumber", "VacantBit", "AvailableBit", "MadeReadyBit", "MadeReadyDate", "UnitMarketRent", "RentSqFtCount", "FloorNumber"]}],
      "direct": {"field": "availability_stage", "map": {}},
      "direct_rules": [
        {"stage": 1, "reason": "AvailableBit = true AND VacantBit = true AND MadeReadyDate >= today + 14 days", "when": [{"field": "VacantBit", "op": "truthy"}, {"field": "AvailableBit", "op": "truthy"}, {"field": "MadeReadyDate", "op": "future_or_equal_days", "value": 14}]},
        {"stage": 0, "reason": "AvailableBit = true AND NOT (VacantBit = true AND MadeReadyDate >= today + 14 days)", "when": [{"field": "AvailableBit", "op": "truthy"}, {"not": {"all": [{"field": "VacantBit", "op": "truthy"}, {"field": "MadeReadyDate", "op": "future_or_equal_days", "value": 14}]}}]},
        {"stage": 9, "reason": "AvailableBit = false", "when": [{"field": "AvailableBit", "op": "equals", "value": false}]}
      ],
      "overrides": [
        {"stage": 9, "reason": "Retail unit", "when": [{"field": "UnitNumber", "op": "contains", "value": "retail"}]},
        {"stage": 9, "reason": "Future availability cutoff", "when": [{"field": "MadeReadyDate", "op": "future_days", "value": 365}]},
        {"stage": 9, "reason": "Invalid Rent", "when": [{"field": "EffectiveRent", "op": "invalid_rent"}]},
        {"stage": 9, "reason": "Invalid square footage", "when": [{"field": "RentSqFtCount", "op": "invalid_sqft"}]}
      ]
    },
    "Entrata": {
      "primary": ["getUnitsAvailabilityAndPricing.json.gz", "getPropertyUnits.json.gz", "getUnitTypes.json.gz"],
      "actual": ["unit_details.json.gz", "unit-details.json.gz"],
      "unit_key": {"components": [["PropertyUnitId"]]},
      "unit_name_fields": ["UnitNumber"],
      "primary_key": ["PropertyUnitId"],
      "required_key": ["PropertyUnitId"],
      "actual_key": ["building_unique_id", "external_id"],
      "fields": ["PropertyUnitId", "UnitId", "unitId", "UnitNumber", "Availability", "Status", "AvailableOn", "FloorLevel", "FloorNumber", "Area", "SquareFeet", "availabilityStatus", "availableDate", "effective_rent", "availability_stage"],
      "sources": [{"file": "getFloorPlans.json.gz", "fields": ["FloorPlanId", "square_feet"]}, {"file": "getPropertyUnits.json.gz", "fields": ["unitNumber", "availabilityStatus", "availableDate", "SquareFeet"]}],
      "direct": {"field": "Availability", "casefold": true, "map": {}},
      "direct_rules": [
        {"stage": 1, "reason": "Status: Vacant Not Ready", "when": [{"field": "Status", "op": "contains", "value": "Vacant Not Ready"}]},
        {"stage": 0, "reason": "Status: Available", "when": [{"field": "Availability", "op": "equals", "value": "Available"}]},
        {"stage": 0, "reason": "Status: Available", "when": [{"field": "availabilityStatus", "op": "equals", "value": "Available"}]},
        {"stage": 0, "reason": "Status: On Notice (Available)", "when": [{"field": "availabilityStatus", "op": "equals", "value": "On Notice (Available)"}]},
        {"stage": 1, "reason": "Status: Vacant Not Ready", "when": [{"field": "availabilityStatus", "op": "contains", "value": "Vacant Not Ready"}]},
        {"stage": 0, "reason": "Student unit type", "when": [{"field": "name", "op": "truthy"}]}
      ],
      "fallback": {"stage": 9, "reason": "Status: unavailable or unsupported"},
      "overrides": [
        {"stage": 9, "reason": "Missing available date", "when": [{"any": [{"field": "Availability", "op": "truthy"}, {"field": "availabilityStatus", "op": "truthy"}]}, {"all": [{"field": "AvailableOn", "op": "missing"}, {"field": "availableDate", "op": "missing"}]}]},
        {"stage": 9, "reason": "Future availability cutoff", "when": [{"field": "__direct_stage", "op": "stage_in", "value": [0, 1]}, {"field": "AvailableOn", "op": "future_days", "value": 365}]},
        {"stage": 9, "reason": "Invalid square footage", "when": [{"field": "Area", "op": "invalid_sqft"}]}
      ]
    },
    "AppFolio": {
      "rollouts": {
        "appfolio_ignore_listings_for_availability": {"default": "disabled"}
      },
      "primary": ["units.json.gz"],
      "actual": ["unit_details.json.gz", "unit-details.json.gz"],
      "unit_key": {"components": [["PropertyId"], ["Id"]]},
      "unit_name_fields": ["Name"],
      "primary_key": ["PropertyId", "Id"],
      "required_key": ["PropertyId", "Id"],
      "actual_key": ["building_unique_id", "external_id"],
      "fields": ["PropertyId", "Id", "UnitId", "Name", "MarketingTitle", "Status", "RentReady", "ListedRent", "MarketRent", "AvailableOn", "SquareFeet", "HiddenAt", "PostedToWebsite", "availability_stage"],
      "sources": [{"file": "listing.json.gz", "join_key": ["UnitId"], "primary_key": ["Id"], "fields": ["UnitId", "PostedToWebsite"]}, {"file": "property.json.gz", "fields": ["name", "Name"]}],
      "direct": {"field": "Status", "map": {}},
      "direct_rules": [
        {"stage": 0, "reason": "Status: Vacant, RentReady: True", "when": [{"field": "Status", "op": "equals", "value": "Vacant"}, {"field": "RentReady", "op": "truthy"}]},
        {"stage": 1, "reason": "Status: Vacant, RentReady: False", "when": [{"field": "Status", "op": "equals", "value": "Vacant"}, {"field": "RentReady", "op": "falsey"}]},
        {"stage": 1, "reason": "Status: Notice", "when": [{"field": "Status", "op": "equals", "value": "Notice"}]},
        {"stage": 9, "reason": "Status: Occupied", "when": [{"field": "Status", "op": "equals", "value": "Occupied"}]},
        {"stage": 9, "reason": "Status: Notice Rented", "when": [{"field": "Status", "op": "equals", "value": "Notice Rented"}]},
        {"stage": 9, "reason": "Status: Vacant Rented", "when": [{"field": "Status", "op": "equals", "value": "Vacant Rented"}]}
      ],
      "fallback": {"stage": 9, "reason": "Status: unavailable or unsupported"},
      "overrides": [
        {"stage": 9, "reason": "Unit Marked as Hidden", "when": [{"field": "HiddenAt", "op": "truthy"}]},
        {"stage": 9, "reason": "Not Posted to Website", "when": [{"field": "__rollout__appfolio_ignore_listings_for_availability", "op": "equals", "value": "disabled"}, {"all": [{"field": "primary__PostedToWebsite", "op": "falsey"}, {"field": "listing.json.gz__PostedToWebsite", "op": "falsey"}]}]},
        {"stage": 9, "reason": "Missing Available Date", "when": [{"field": "AvailableOn", "op": "missing"}]},
        {"stage": 9, "reason": "Future Availability Cutoff: 1 Year", "when": [{"field": "__direct_stage", "op": "stage_in", "value": [0, 1]}, {"field": "AvailableOn", "op": "future_days", "value": 365}]},
        {"stage": 9, "reason": "Invalid Rent", "when": [{"all": [{"field": "ListedRent", "op": "invalid_rent"}, {"field": "MarketRent", "op": "invalid_rent"}]}]},
        {"stage": 9, "reason": "Invalid Square Footage", "when": [{"field": "SquareFeet", "op": "invalid_sqft"}]}
      ]
    },
    "ResMan": {
      "primary": ["GetMarketing"],
      "actual": ["unit_details.json.gz", "unit-details.json.gz"],
      "unit_key": {"components": [["UnitID"]], "phase_prefix_when_multiple": ["PropertyID"]},
      "unit_name_fields": ["MarketingName", "UnitNumber"],
      "primary_key": ["PropertyID", "UnitID"],
      "required_key": ["UnitID"],
      "actual_key": ["building_unique_id", "external_id"],
      "fields": ["PropertyID", "PropertyId", "UnitID", "UnitId", "MarketingName", "UnitNumber", "UnitLeasedStatus", "MadeReadyDate", "EffectiveRent", "MarketRent", "FloorLevel", "MinSquareFeet", "availability_stage"],
      "sources": [{"file": "GetUnitAvailability", "join_key": ["number"], "fields": ["number", "status", "dateAvailable", "floor", "squareFeet"]}, {"file": "GetUnitTypes", "join_key": ["unitTypeId"], "fields": ["unitTypeId", "marketRent", "squareFootage"]}],
      "direct": {"field": "UnitLeasedStatus", "casefold": true, "map": {}},
      "direct_rules": [
        {"stage": 1, "reason": "Status: Available, MadeReady: False", "when": [{"field": "UnitLeasedStatus", "op": "equals", "value": "available"}, {"field": "MadeReadyDate", "op": "future"}]},
        {"stage": 0, "reason": "Status: Available, MadeReady: True", "when": [{"field": "UnitLeasedStatus", "op": "equals", "value": "available"}]},
        {"stage": 1, "reason": "Status: On Notice, MadeReady: False", "when": [{"field": "UnitLeasedStatus", "op": "equals", "value": "on_notice"}, {"field": "MadeReadyDate", "op": "future"}]},
        {"stage": 0, "reason": "Status: On Notice, MadeReady: True", "when": [{"field": "UnitLeasedStatus", "op": "equals", "value": "on_notice"}]}
      ],
      "fallback": {"stage": 9, "reason": "Status: unavailable or unsupported"},
      "overrides": [
        {"stage": 9, "reason": "Missing made-ready date", "when": [{"field": "MadeReadyDate", "op": "missing"}]},
        {"stage": 9, "reason": "Future availability cutoff", "when": [{"field": "__direct_stage", "op": "stage_in", "value": [0, 1]}, {"field": "MadeReadyDate", "op": "future_days", "value": 365}]},
        {"stage": 9, "reason": "Unsupported or leased status", "when": [{"field": "UnitLeasedStatus", "op": "missing"}]},
        {"stage": 9, "reason": "Invalid Rent", "when": [{"field": "EffectiveRent", "op": "invalid_rent"}]},
        {"stage": 9, "reason": "Invalid square footage", "when": [{"field": "MinSquareFeet", "op": "invalid_sqft"}]}
      ]
    },
    "EQR MRI": {
      "primary": ["PARAM_UNIT_AVAILABILITY"],
      "actual": ["unit_details.json.gz", "unit-details.json.gz"],
      "unit_key": {"components": [["BldgID"], ["UnitID"]], "phase_prefix_when_multiple": ["PropertyID"]},
      "unit_name_fields": ["UnitID"],
      "primary_key": ["PropertyID", "BldgID", "UnitID"],
      "required_key": ["UnitID"],
      "actual_key": ["building_unique_id", "external_id"],
      "fields": ["PropertyID", "PropertyId", "BuildingID", "BldgID", "UnitID", "AvailabilityStatus", "MakeReadyFlag", "EarliestAvailable", "MakeReadyDate", "SquareFeet", "FloorNumber", "HTPRent", "availability_stage"],
      "sources": [{"file": "PARAM_RENTS", "join_key": ["UnitID"], "fields": ["BldgID", "UnitID", "HTPRent", "Term"]}, {"file": "PARAM_SPECIALS", "join_key": ["UnitID"], "fields": ["RMBldgID", "UnitID"]}],
      "direct": {"field": "AvailabilityStatus", "casefold": true, "map": {}},
      "direct_rules": [
        {"stage": 1, "reason": "Status: Available, MakeReady: False", "when": [{"field": "AvailabilityStatus", "op": "equals", "value": "available"}, {"field": "MakeReadyFlag", "op": "not_equals", "value": "Y"}]},
        {"stage": 0, "reason": "Status: Available, MakeReady: True", "when": [{"field": "AvailabilityStatus", "op": "equals", "value": "available"}]},
        {"stage": 9, "reason": "Status: Reserved", "when": [{"field": "AvailabilityStatus", "op": "equals", "value": "reserved"}]}
      ],
      "fallback": {"stage": -1, "reason": "Status: unsupported or unknown"},
      "overrides": [
        {"stage": 9, "reason": "Missing made-ready date", "when": [{"field": "EarliestAvailable", "op": "missing"}, {"field": "MakeReadyDate", "op": "missing"}]},
        {"stage": 9, "reason": "Invalid Rent", "when": [{"field": "HTPRent", "op": "invalid_rent"}]},
        {"stage": 9, "reason": "Invalid square footage", "when": [{"field": "SquareFeet", "op": "invalid_sqft"}]}
      ]
    },
    "AVB": {
      "primary": ["search_community_units_v2"],
      "actual": ["unit_details.json.gz", "unit-details.json.gz"],
      "unit_key": {"components": [["unitId"]]},
      "unit_name_fields": ["unitId"],
      "primary_key": ["unitId"],
      "required_key": ["unitId"],
      "actual_key": ["building_unique_id", "external_id"],
      "fields": ["unitId", "propertyId", "isTourable", "availableDateUnfurnished", "availableDateFurnished", "squareFeet", "floorNumber", "availability_stage"],
      "sources": [{"file": "sftp_places", "join_key": ["unit_id"], "fields": ["unit_id", "unit_number", "floor", "last_move_out_date", "unit_size"]}],
      "direct": {"field": "isTourable", "casefold": true, "map": {"true": 0, "false": 1}},
      "overrides": [
        {"stage": 9, "reason": "Missing available date", "when": [{"field": "availableDateUnfurnished", "op": "missing"}, {"field": "availableDateFurnished", "op": "missing"}]},
        {"stage": 9, "reason": "Future availability cutoff", "when": [{"field": "availableDateUnfurnished", "op": "future_days", "value": 365}]},
        {"stage": 9, "reason": "Invalid square footage", "when": [{"field": "squareFeet", "op": "invalid_sqft"}]}
      ]
    }
  }
}
